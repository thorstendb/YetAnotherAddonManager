{
  "name": "yaam",
  "version": "1.0.0",
  "description": "YAAM - Yet Another Addon Manager",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "vite build && electron .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist": "yarn build && electron-builder --win --publish never",
    "dist:mac": "yarn build && electron-builder --mac --publish never",
    "dist:linux": "yarn build && electron-builder --linux --publish never",
    "dist:all": "yarn build && electron-builder --win --mac --publish never",
    "release": "yarn build && electron-builder --win --mac --publish always"
  },
  "author": "thorstendb",
  "license": "MIT",
  "homepage": "https://github.com/thorstendb/YetAnotherAddonManager",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "build": {
    "appId": "com.yaam.app",
    "productName": "YAAM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null,
      "publisherName": "thorstendb",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": null,
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-${version}-setup.exe"
    }
  }
}

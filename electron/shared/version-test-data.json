{
  "_comment": "Real-world version strings from ESO addons, deduplicated by structural pattern. Used as reference for parseVersionParts / compareVersionStrings tests.",
  "parseTests": [
    {
      "pattern": "simple integer",
      "input": "86",
      "addon": "LibCombat",
      "expectedParts": [86],
      "expectedSubParts": []
    },
    {
      "pattern": "two-part (X.Y)",
      "input": "1.0",
      "addon": "TributeImprovedLeaderboard",
      "expectedParts": [1, 0],
      "expectedSubParts": []
    },
    {
      "pattern": "two-part, implicit (no dot in second segment)",
      "input": "1.009",
      "addon": "LibMOTD",
      "expectedParts": [1, 9],
      "expectedSubParts": []
    },
    {
      "pattern": "two-part, large major",
      "input": "101032.1",
      "addon": "CompanionInfo",
      "expectedParts": [101032, 1],
      "expectedSubParts": []
    },
    {
      "pattern": "two-part, dot-r revision",
      "input": "2.r1",
      "addon": "LibSort",
      "expectedParts": [2],
      "expectedSubParts": [],
      "expectedSuffix": "r",
      "expectedSuffixParts": [1]
    },
    {
      "pattern": "two-part, v-prefix",
      "input": "v2.31",
      "addon": "SousChef",
      "expectedParts": [2, 31],
      "expectedSubParts": []
    },
    {
      "pattern": "three-part (semver)",
      "input": "0.8.9",
      "addon": "LibSets",
      "expectedParts": [0, 8, 9],
      "expectedSubParts": []
    },
    {
      "pattern": "three-part, space-r revision",
      "input": "2.0 r41",
      "addon": "LibAddonMenu-2.0",
      "expectedParts": [2, 0],
      "expectedSubParts": [],
      "expectedSuffix": "r",
      "expectedSuffixParts": [41]
    },
    {
      "pattern": "four-part",
      "input": "10.0.7.2",
      "addon": "pChat",
      "expectedParts": [10, 0, 7, 2],
      "expectedSubParts": []
    },
    {
      "pattern": "four-part, concatenated r-revision",
      "input": "3.0r5.0",
      "addon": "LibFilters-3.0",
      "expectedParts": [3, 0],
      "expectedSubParts": [],
      "expectedSuffix": "r",
      "expectedSuffixParts": [5, 0]
    },
    {
      "pattern": "four-part, build keyword",
      "input": "2.3.22 build 1442",
      "addon": "GuildHallButton",
      "expectedParts": [2, 3, 22],
      "expectedSubParts": [],
      "expectedSuffix": "build",
      "expectedSuffixParts": [1442]
    },
    {
      "pattern": "four-part, very large segments",
      "input": "4.26.832.28195",
      "addon": "TamrielTradeCentre",
      "expectedParts": [4, 26, 832, 28195],
      "expectedSubParts": []
    },
    {
      "pattern": "five-part",
      "input": "4.0.4.3.5",
      "addon": "DolgubonsLazyWritCreator",
      "expectedParts": [4, 0, 4, 3, 5],
      "expectedSubParts": []
    },
    {
      "pattern": "date-based (YYYY.MM.DD)",
      "input": "2025.08.08",
      "addon": "PersonalAssistant",
      "expectedParts": [2025, 8, 8],
      "expectedSubParts": []
    },
    {
      "pattern": "date-based (YYYY-MM-DD)",
      "input": "2026-03-30",
      "addon": "HodorReflexes",
      "expectedParts": [2026, 3, 30],
      "expectedSubParts": []
    },
    {
      "pattern": "date with parenthesized build number",
      "input": "2026-03-04 (20260304)",
      "addon": "synthetic",
      "expectedParts": [2026, 3, 4],
      "expectedSubParts": [20260304]
    },
    {
      "pattern": "semver with parenthesized date",
      "input": "1.2.3 (2026-01-15)",
      "addon": "synthetic",
      "expectedParts": [1, 2, 3],
      "expectedSubParts": [2026, 1, 15]
    },
    {
      "pattern": "semver with parenthesized build",
      "input": "2.3.22 (build 1442)",
      "addon": "synthetic",
      "expectedParts": [2, 3, 22],
      "expectedSubParts": [1442]
    },
    {
      "pattern": "pre-release alpha",
      "input": "1.0-alpha",
      "addon": "synthetic",
      "expectedParts": [1, 0],
      "expectedSubParts": [],
      "expectedPreRelease": "alpha",
      "expectedPreReleaseNum": 0
    },
    {
      "pattern": "pre-release rc with number",
      "input": "1.0-rc.2",
      "addon": "synthetic",
      "expectedParts": [1, 0],
      "expectedSubParts": [],
      "expectedPreRelease": "rc",
      "expectedPreReleaseNum": 2
    },
    {
      "pattern": "hotfix letter suffix",
      "input": "3.16.7b",
      "addon": "HarvestMap (catalog)",
      "expectedParts": [3, 16, 7],
      "expectedSubParts": [],
      "expectedLetterRank": 2
    },
    {
      "pattern": "hotfix letter suffix on LangPatch version",
      "input": "2.1.5b",
      "addon": "AsylumTracker.LangPatch (catalog)",
      "expectedParts": [2, 1, 5],
      "expectedSubParts": [],
      "expectedLetterRank": 2
    },
    {
      "pattern": "compact datestamp (YYYYMMDD)",
      "input": "20240310",
      "addon": "HodorReflexes (AddOnVersion)",
      "expectedParts": [2024, 3, 10],
      "expectedSubParts": []
    },
    {
      "pattern": "multi-letter tail is ignored (language tag, not hotfix)",
      "input": "36.23PL",
      "addon": "PL Patch for Dolgubon's (catalog)",
      "expectedParts": [36, 23],
      "expectedSubParts": [],
      "expectedLetterRank": 0
    },
    {
      "pattern": "word tail is ignored",
      "input": "1.02-custom",
      "addon": "Dryzler's Taunt Helper Tank Only (catalog)",
      "expectedParts": [1, 2],
      "expectedSubParts": [],
      "expectedLetterRank": 0
    }
  ],
  "compareTests": [
    {
      "description": "simple integer: older < newer",
      "a": "86",
      "b": "104",
      "expected": "a<b"
    },
    {
      "description": "two-part: minor bump",
      "a": "4.434",
      "b": "4.435",
      "expected": "a<b"
    },
    {
      "description": "two-part: implicit format vs dotted",
      "a": "1.009",
      "b": "1.05",
      "expected": "a>b"
    },
    {
      "description": "three-part semver: patch bump",
      "a": "0.8.9",
      "b": "0.9.0",
      "expected": "a<b"
    },
    {
      "description": "three-part: space-r revision bump",
      "a": "2.0 r41",
      "b": "2.0 r42",
      "expected": "a<b"
    },
    {
      "description": "four-part: last segment bump",
      "a": "10.0.7.2",
      "b": "10.0.7.3",
      "expected": "a<b"
    },
    {
      "description": "four-part: build keyword bump",
      "a": "2.3.22 build 1442",
      "b": "2.3.22 build 1500",
      "expected": "a<b"
    },
    {
      "description": "five-part: last segment differs",
      "a": "4.0.4.3.5",
      "b": "4.0.4.3.6",
      "expected": "a<b"
    },
    {
      "description": "five-part vs six-part: trailing zero means older",
      "a": "4.0.5.6.0.1",
      "b": "4.0.5.6.1",
      "expected": "a<b"
    },
    {
      "description": "date-based YYYY.MM.DD: different months",
      "a": "2025.03.14",
      "b": "2025.08.08",
      "expected": "a<b"
    },
    {
      "description": "date-based YYYY-MM-DD: day bump",
      "a": "2026-03-29",
      "b": "2026-03-30",
      "expected": "a<b"
    },
    {
      "description": "date dots vs date hyphens: same date",
      "a": "2026.03.30",
      "b": "2026-03-30",
      "expected": "a=b"
    },
    {
      "description": "date with build number: same main, sub differs",
      "a": "2026-03-04 (20260304)",
      "b": "2026-03-04 (20260305)",
      "expected": "a<b"
    },
    {
      "description": "semver with parenthesized date tiebreaker",
      "a": "1.2.3 (2026-01-01)",
      "b": "1.2.3 (2026-03-01)",
      "expected": "a<b"
    },
    {
      "description": "semver vs semver with sub: sub wins as tiebreaker",
      "a": "1.2.3",
      "b": "1.2.3 (2026-01-01)",
      "expected": "a<b"
    },
    {
      "description": "semver with parenthesized build: build differs",
      "a": "1.2.3 (build 456)",
      "b": "1.2.3 (build 789)",
      "expected": "a<b"
    },
    {
      "description": "v-prefix stripped: equal to plain",
      "a": "v2.31",
      "b": "2.31",
      "expected": "a=b"
    },
    {
      "description": "pre-release < release",
      "a": "1.0-rc",
      "b": "1.0",
      "expected": "a<b"
    },
    {
      "description": "pre-release ordering: alpha < beta",
      "a": "1.0-alpha",
      "b": "1.0-beta",
      "expected": "a<b"
    },
    {
      "description": "large version vs date: not confused as date",
      "a": "4.26.832.28195",
      "b": "4.26.832.28196",
      "expected": "a<b"
    },
    {
      "description": "concatenated r-revision bump",
      "a": "3.0r5.0",
      "b": "3.0r6.0",
      "expected": "a<b"
    },
    {
      "description": "empty vs any version",
      "a": "",
      "b": "1.0",
      "expected": "a<b"
    },
    {
      "description": "scheme change: semver→date, catalog date is newer",
      "a": "1.2.3",
      "b": "2026-03-30",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "catalogDate = 2026-03-30T00:00:00Z; local is old semver, catalog switched to date"
    },
    {
      "description": "scheme change: date→semver, catalog date is newer",
      "a": "2025-08-08",
      "b": "2.0.0",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "catalogDate = 2026-03-30; local had date scheme, catalog now semver"
    },
    {
      "description": "scheme change: date→semver, catalog date is older",
      "a": "2026-03-30",
      "b": "2.0.0",
      "catalogDate": 1767225600,
      "expected": "a>b",
      "_note": "catalogDate = 2026-01-01; local date is newer than catalog upload"
    },
    {
      "description": "scheme change: semver→date, no catalogDate falls through",
      "a": "1.2.3",
      "b": "2026-03-30",
      "expected": "a<b",
      "_note": "without catalogDate, raw numeric comparison still says 1 < 2026"
    },
    {
      "description": "scheme change: short int→semver (HarvestMap: 49→3.16.5)",
      "a": "49",
      "b": "3.16.5",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Scheme mismatch: return 0 (unknown). .yaam.json version check handles real updates"
    },
    {
      "description": "scheme change: large int→semver (31605→3.16.5)",
      "a": "31605",
      "b": "3.16.5",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Scheme mismatch: return 0 (unknown). .yaam.json version check handles real updates"
    },
    {
      "description": "scheme change: two-part→semver (316.5→3.16.5)",
      "a": "316.5",
      "b": "3.16.5",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Scheme mismatch: return 0 (unknown). .yaam.json version check handles real updates"
    },
    {
      "description": "scheme change: two-part→semver (1.2→3.16.5)",
      "a": "1.2",
      "b": "3.16.5",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Scheme mismatch: return 0 (unknown). .yaam.json version check handles real updates"
    },
    {
      "description": "scheme change: semver→short (3.16.5→49, reverse)",
      "a": "3.16.5",
      "b": "49",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Scheme mismatch: return 0 (unknown). .yaam.json version check handles real updates"
    },
    {
      "description": "scheme change: semver→single int (1.2.3→100)",
      "a": "1.2.3",
      "b": "100",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Scheme mismatch: return 0 (unknown). .yaam.json version check handles real updates"
    },
    {
      "description": "scheme change: date→short with catalogDate",
      "a": "2025.08.08",
      "b": "49",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "local is date-based, catalog switched to build number, catalog date = 2026-03-30"
    },
    {
      "description": "scheme change: short→date with catalogDate",
      "a": "49",
      "b": "2026-03-30",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "local is build number, catalog switched to date-based"
    },
    {
      "description": "no false positive: same-scheme semver 5.0.0 > 3.16.5",
      "a": "5.0.0",
      "b": "3.16.5",
      "catalogDate": 1762720907,
      "expected": "a>b",
      "_note": "both are 3-part semver, no scheme mismatch"
    },
    {
      "description": "no false positive: same-scheme single int 100 > 49",
      "a": "100",
      "b": "49",
      "catalogDate": 1762720907,
      "expected": "a>b",
      "_note": "both are single integers, normal comparison"
    },
    {
      "description": "no false positive: same-scheme two-part 2.0 > 1.5",
      "a": "2.0",
      "b": "1.5",
      "catalogDate": 1762720907,
      "expected": "a>b",
      "_note": "both are two-part, normal comparison"
    },
    {
      "description": "short→semver without catalogDate: raw fallback (49 > 3)",
      "a": "49",
      "b": "3.16.5",
      "expected": "a>b",
      "_note": "without catalogDate, raw numeric comparison: 49 > 3"
    },
    {
      "description": "r-revision: revision bump (LibAddonMenu 2.0 r41→r42)",
      "a": "2.0 r41",
      "b": "2.0 r42",
      "expected": "a<b",
      "_note": "LibAddonMenu-2.0 style: '2.0 r41' < '2.0 r42'"
    },
    {
      "description": "r-revision: same revision is equal",
      "a": "2.0 r41",
      "b": "2.0 r41",
      "expected": "a=b",
      "_note": "LibAddonMenu-2.0: same r-revision"
    },
    {
      "description": "r-revision: base version < version with revision",
      "a": "2.0",
      "b": "2.0 r41",
      "expected": "a<b",
      "_note": "'2.0' ([2,0]) is a prefix of '2.0 r41' ([2,0,41]) — not a scheme change"
    },
    {
      "description": "r-revision: version with revision > base version",
      "a": "2.0 r41",
      "b": "2.0",
      "expected": "a>b",
      "_note": "'2.0 r41' ([2,0,41]) > '2.0' ([2,0]) — trailing revision part wins"
    },
    {
      "description": "r-revision: base vs revision with catalogDate (not a scheme change)",
      "a": "2.0",
      "b": "2.0 r41",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "Prefix match prevents false scheme-mismatch; normal comparison applies"
    },
    {
      "description": "suffix mismatch: r vs build without catalogDate → unknown",
      "a": "2.0 r41",
      "b": "2.0 build 5",
      "expected": "a==b",
      "_note": "Different suffix keywords → scheme mismatch, no catalogDate → return 0"
    },
    {
      "description": "suffix mismatch: r vs build with catalogDate → catalog wins",
      "a": "2.0 r41",
      "b": "2.0 build 5",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "Different suffix keywords → scheme mismatch → catalog is authoritative"
    },
    {
      "description": "same suffix: both r → normal revision compare",
      "a": "2.0 r41",
      "b": "2.0 r42",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "Same suffix 'r' → compare revision numbers normally"
    },
    {
      "description": "same suffix: both build → normal build compare",
      "a": "2.3.22 build 1442",
      "b": "2.3.22 build 1500",
      "catalogDate": 1774828800,
      "expected": "a<b",
      "_note": "Same suffix 'build' → compare build numbers normally"
    },
    {
      "description": "hotfix letter: plain < lettered (HarvestMap 3.16.7 → 3.16.7b)",
      "a": "3.16.7",
      "b": "3.16.7b",
      "expected": "a<b",
      "_note": "Letter re-release must be detected as an update, not digit-equal"
    },
    {
      "description": "hotfix letter ordering: a < b",
      "a": "3.16.7a",
      "b": "3.16.7b",
      "expected": "a<b"
    },
    {
      "description": "hotfix letter: lettered > plain (reverse)",
      "a": "2.1.5b",
      "b": "2.1.5",
      "expected": "a>b",
      "_note": "AsylumTracker.LangPatch catalog style"
    },
    {
      "description": "scheme change: concatenated int vs lettered semver (HarvestMap 315999 vs 3.16.7b)",
      "a": "315999",
      "b": "3.16.7b",
      "catalogDate": 1762720907,
      "expected": "a==b",
      "_note": "Real local manifest vs catalog. Scheme mismatch → 0; Tier-2 tracking resolves it"
    },
    {
      "description": "compact datestamp ≡ dotted date (HodorReflexes 20240310 = 2024.03.10)",
      "a": "20240310",
      "b": "2024.03.10",
      "expected": "a=b"
    },
    {
      "description": "compact datestamp: day bump",
      "a": "20240310",
      "b": "2024.03.11",
      "expected": "a<b"
    },
    {
      "description": "scheme change: compact datestamp → semver with catalogDate (user example 20260620 → 2.7.1)",
      "a": "20260620",
      "b": "2.7.1",
      "catalogDate": 1782950400,
      "expected": "a<b",
      "_note": "catalogDate = 2026-07-01; local datestamp 2026-06-20 is older than catalog upload"
    },
    {
      "description": "scheme change: compact datestamp → semver, local datestamp newer",
      "a": "20260620",
      "b": "2.7.1",
      "catalogDate": 1767225600,
      "expected": "a>b",
      "_note": "catalogDate = 2026-01-01; local datestamp is newer — no update"
    },
    {
      "description": "manifest more detailed than catalog field (GuildHallButton)",
      "a": "2.3.22 build 1442",
      "b": "2.3.22",
      "expected": "a>b",
      "_note": "Real case: author writes build number only into the manifest — not an update"
    },
    {
      "description": "stale manifest vs counted-up catalog (LibQRCode 1.0 vs 1.0.8)",
      "a": "1.0",
      "b": "1.0.8",
      "catalogDate": 1751476805,
      "expected": "a==b",
      "_note": "Real case: author never bumps ## Version. Inconclusive → Tier-2 tracking decides"
    },
    {
      "description": "plain short bump (displayleads 42.0 → 42.1)",
      "a": "42.0",
      "b": "42.1",
      "expected": "a<b"
    }
  ]
}
